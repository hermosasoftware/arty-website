---
import { getTranslations } from '../../i18n/translations';
import type { Locale } from '../../i18n/translations';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const stats = [
  { value: '35+', label: t.about.stats.projectsCompleted },
  { value: '6+', label: t.about.stats.yearsExperience },
  { value: '60%', label: t.about.stats.clientSatisfaction },
];
---
<!-- About Us Section -->
<section id="about" class="py-24 bg-white">
  <div class="max-w-6xl mx-auto lg:px-0 px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-semibold mb-4 text-gray-800">{t.about.title}</h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">{t.about.subtitle}</p>
    </div>
    <!-- Desktop: 2 columns (text+stats | image). Mobile: text then row [stats | image] -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div>
        <h3 class="text-3xl font-semibold mb-6 text-gray-800">{t.about.heading}</h3>
        <p class="mb-6 text-gray-600 leading-relaxed">
          {t.about.paragraph1}
        </p>
        <p class="mb-6 text-gray-600 leading-relaxed">
          {t.about.paragraph2}
        </p>
        <div class="hidden lg:grid grid-cols-3 gap-8 mt-8">
          {stats.map((stat) => (
            <div class="text-center">
              <h4 class="text-3xl font-semibold text-gray-800 mb-2">{stat.value}</h4>
              <p class="text-gray-600 text-sm">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="hidden lg:flex lg:justify-end justify-center">
        <img src="/assets/aboutUs-image/about-us-image.jpg" alt={t.about.imageAlt} class="w-2/5 object-cover rounded-lg" />
      </div>
    </div>
    <!-- Mobile only: one row, stats left, image right, height matches image -->
    <div class="flex flex-row items-stretch gap-4 mt-8 lg:hidden">
      <div class="flex-1 flex flex-col justify-between min-w-0">
        {stats.map((stat) => (
          <div class="text-center py-2">
            <h4 class="text-2xl font-semibold text-gray-800 mb-1">{stat.value}</h4>
            <p class="text-gray-600 text-xs">{stat.label}</p>
          </div>
        ))}
      </div>
      <div class="shrink-0 w-2/5">
        <img src="/assets/aboutUs-image/about-us-image.jpg" alt={t.about.imageAlt} class="w-full h-full object-cover rounded-lg" />
      </div>
    </div>
  </div>
</section>


