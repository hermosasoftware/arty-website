---
import Card from '../Card.tsx';
import { getTranslations } from '../../i18n/translations';
import type { Locale } from '../../i18n/translations';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const imagePaths = [
  '/assets/cards-images/iconos transparentes_1.png',
  '/assets/cards-images/iconos transparentes_2.png',
  '/assets/cards-images/iconos transparentes_3.png',
  '/assets/cards-images/iconos transparentes_4.png',
  '/assets/cards-images/Iconos - Historias Destacadas_4_1.png',
  '/assets/cards-images/iconos transparentes_5.png',
];
const services = t.services.items.map((item, index) => ({
  image: imagePaths[index]!,
  alt: item.alt,
  title: item.title,
  description: item.description,
}));
---

<!-- Services Section -->
<section id="services" class="py-24">
  <div class="max-w-6xl mx-auto px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-semibold mb-4 text-gray-800">{t.services.title}</h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">{t.services.subtitle}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.map((service, index) => (
        <Card
          image={service.image}
          alt={service.alt}
          title={service.title}
          description={service.description}
          variant="service"
          client:load
        />
      ))}
    </div>
  </div>
</section>


