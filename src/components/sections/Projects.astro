---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Card from '../Card.tsx';
import { getTranslations } from '../../i18n/translations';
import { getProjectsList } from '../../i18n/projects';
import type { Locale } from '../../i18n/translations';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const projectList = getProjectsList(locale).map((p) => ({
  ...p,
  link: getRelativeLocaleUrl(locale, `/projects/${p.slug}`),
}));
---

<!-- Projects Section -->
<section id="projects" class="py-24 bg-white">
  <div class="max-w-6xl mx-auto px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-semibold mb-4 text-gray-800">{t.projects.title}</h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">{t.projects.subtitle}</p>
      <a href="https://drive.google.com/drive/folders/1J9jzDx8REKHP2cz6N_SDDBPTPJrXl9-v" target="_blank" class="text-gray-800 border-b border-gray-800 font-medium transition-colors duration-300 hover:text-gray-600">{t.projects.portfolioLink}</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projectList.map((project) => (
        <Card
          image={project.image}
          alt={project.alt}
          title={project.title}
          description={project.description}
          link={project.link}
          linkText={t.common.viewDetails}
          variant="project"
          client:load
        />
      ))}
    </div>
  </div>
</section>


