---
import { getTranslations } from '../../i18n/translations';
import type { Locale } from '../../i18n/translations';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const formspreeUrl = import.meta.env.FORMSPREE_URL || '';
const contact = [
  { title: t.contact.email, value: 'mmora@artyarquitectura.com' },
  { title: t.contact.phone, value: '+506 89567307' },
  { title: t.contact.address, value: t.contact.addressValue },
  { title: t.contact.hours, value: t.contact.hoursValue },
];
---
<!-- Contact Section -->
<section id="contact" class="py-24">
  <div class="max-w-6xl mx-auto px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-semibold mb-4 text-gray-800">{t.contact.title}</h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">{t.contact.subtitle}</p>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 ">
      <div class="contact-info bg-gray-50 p-2 rounded-lg">
        <h3 class="text-3xl font-semibold mb-8 text-gray-800">{t.contact.getInTouch}</h3>
        <div class="space-y-8">
          {contact.map((item) => (
            <div class="contact-item">
              <h4 class="text-lg font-semibold mb-2 text-gray-800">{item.title}</h4>
              <p class="text-gray-600 leading-relaxed">{item.value}</p>
            </div>
          ))}
        </div>
      </div>
      <form class="contact-form flex flex-col space-y-6" data-formspree-url={formspreeUrl} data-success-message={t.contact.messageSentSuccess} data-error-message={t.contact.messageSentError} data-submit-label={t.contact.sendMessage} method="POST">
        <div id="form-message" class="hidden p-4 rounded text-base" role="status" aria-live="polite"></div>
        <div class="form-group">
          <input type="text" name="name" placeholder={t.contact.placeholderName} required class="w-full p-4 border border-gray-300 rounded text-base font-inherit transition-colors duration-300 focus:outline-none focus:border-gray-800">
        </div>
        <div class="form-group">
          <input type="email" name="email" placeholder={t.contact.placeholderEmail} required class="w-full p-4 border border-gray-300 rounded text-base font-inherit transition-colors duration-300 focus:outline-none focus:border-gray-800">
        </div>
        <div class="form-group">
          <input type="text" name="subject" placeholder={t.contact.placeholderSubject} required class="w-full p-4 border border-gray-300 rounded text-base font-inherit transition-colors duration-300 focus:outline-none focus:border-gray-800">
        </div>
        <div class="form-group">
          <textarea name="message" placeholder={t.contact.placeholderMessage} rows="5" required class="w-full p-4 border border-gray-300 rounded text-base font-inherit transition-colors duration-300 focus:outline-none focus:border-gray-800"></textarea>
        </div>
        <button type="submit" class="bg-gray-800 text-white px-8 py-4 border-none rounded text-base font-medium cursor-pointer transition-colors duration-300 hover:bg-gray-600">{t.contact.sendMessage}</button>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('.contact-form');
  const messageEl = document.getElementById('form-message');
  if (form && messageEl) {
    const msgEl = messageEl;
    const url = form.dataset.formspreeUrl;
    const successText = form.dataset.successMessage ?? 'Message sent successfully.';
    const errorText = form.dataset.errorMessage ?? 'Something went wrong. Please try again.';

    function showMessage(text: string, isError: boolean) {
      msgEl.textContent = text;
      msgEl.classList.remove('hidden');
      msgEl.classList.remove('bg-green-100', 'text-green-800', 'bg-red-100', 'text-red-800');
      msgEl.classList.add(isError ? 'bg-red-100' : 'bg-green-100', isError ? 'text-red-800' : 'text-green-800');
    }

    function hideMessage() {
      msgEl.classList.add('hidden');
      msgEl.textContent = '';
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!url) {
        showMessage(errorText, true);
        return;
      }
      hideMessage();
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = '...';
      }
      try {
        const body = new FormData(form);
        const res = await fetch(url, {
          method: 'POST',
          body,
          headers: { Accept: 'application/json' },
        });
        const data = await res.json().catch(() => ({}));
        if (data.ok !== false && res.ok) {
          showMessage(successText, false);
          form.reset();
        } else {
          showMessage(errorText, true);
        }
      } catch {
        showMessage(errorText, true);
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = form.dataset.submitLabel || 'Send Message';
        }
      }
    });
  }
</script>

